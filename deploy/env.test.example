# Client Test — Minimal EC2 deployment
# Copy to .env.test on EC2 and fill in values
SECRET_KEY=replace-with-long-random-string
ADMIN_PASSWORD=replace-me
OPERATOR_PASSWORD=replace-me
DEFAULT_SESSION_ROLE=Security Operator

# EC2 public IP — client opens http://EC2_PUBLIC_IP
NEXT_UI_ORIGIN=http://localhost:3000
FLASK_ORIGIN=http://backend:5001

# Skip heavy features for client test
SKIP_THREAT_ENGINE=true
SKIP_LOCAL_WEBCAM=true
ENABLE_LOCAL_HTTPS_PROXY=false
