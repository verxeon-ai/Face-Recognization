# Copy to .env.aws on the EC2 host and fill in values
SECRET_KEY=replace-with-long-random-string
ADMIN_PASSWORD=replace-me
OPERATOR_PASSWORD=replace-me
DEFAULT_SESSION_ROLE=Security Operator

# Must be the public HTTPS URL users open (custom domain or ALB DNS via ACM)
# Example custom domain: https://aegis.yourdomain.com
# Example ALB (after ACM): https://aegis-xxxxx.ap-south-1.elb.amazonaws.com
PUBLIC_BASE_URL=https://YOUR_HTTPS_HOSTNAME

ENABLE_LOCAL_HTTPS_PROXY=false
SKIP_LOCAL_WEBCAM=true
