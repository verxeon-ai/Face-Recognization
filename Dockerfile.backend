# Backend — Flask + OpenCV + YOLO (CPU)
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=5001 \
    ENABLE_LOCAL_HTTPS_PROXY=false \
    SKIP_LOCAL_WEBCAM=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements.prod.txt ./
RUN pip install --upgrade pip \
    && pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements.prod.txt

COPY alert_dispatcher.py \
     recognition_engine.py \
     threat_engine.py \
     train_encodings.py \
     dataset_setup.py \
     app.py \
     yolov8n.pt \
     ./
COPY models/ ./models/
COPY data/ ./data/
COPY dataset/ ./dataset/

RUN mkdir -p uploads results/incident_snapshots results/incident_clips certs \
    && chmod -R a+rwX uploads results data dataset

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD curl -fsS http://127.0.0.1:5001/api/health || exit 1

CMD ["python", "app.py"]
