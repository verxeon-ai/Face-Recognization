# Flask / app secrets — copy to .env and change these
SECRET_KEY=change-me-in-production
ADMIN_PASSWORD=admin123
OPERATOR_PASSWORD=operator123
# New browser sessions start as Security Operator unless set to Admin
DEFAULT_SESSION_ROLE=Security Operator

# ── Local development ──────────────────────────────────────────────
NEXT_UI_ORIGIN=http://localhost:3000
FLASK_ORIGIN=http://127.0.0.1:5001
ENABLE_LOCAL_HTTPS_PROXY=true
SKIP_LOCAL_WEBCAM=false

# ── AWS / cloud (set these on EC2) ─────────────────────────────────
# Public HTTPS URL of the ALB (or custom domain). Required for phone webcam.
# PUBLIC_BASE_URL=https://aegis.example.com
# ENABLE_LOCAL_HTTPS_PROXY=false
# SKIP_LOCAL_WEBCAM=true
# NEXT_UI_ORIGIN=http://frontend:3000
# FLASK_ORIGIN=http://backend:5001
